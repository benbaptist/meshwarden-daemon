# meshcore-daemon configuration
# Copy to .env and adjust. Every value here is optional; defaults shown.

# --- Device connection -------------------------------------------------------
# How the daemon reaches the MeshCore node: serial | tcp
MESHCORED_DEVICE_TRANSPORT=serial
MESHCORED_SERIAL_PORT=/dev/ttyUSB0
MESHCORED_SERIAL_BAUD=115200
# Used when MESHCORED_DEVICE_TRANSPORT=tcp
MESHCORED_DEVICE_TCP_HOST=192.168.1.100
MESHCORED_DEVICE_TCP_PORT=5000
# Seconds to wait for a command response from the node
MESHCORED_COMMAND_TIMEOUT=15
# Library-level reconnect attempts per outage (0 = retry forever)
MESHCORED_RECONNECT_MAX_ATTEMPTS=0
MESHCORED_RECONNECT_BACKOFF_MAX=60

# --- Data / storage ----------------------------------------------------------
# Inside Docker this is /data (a named volume); outside, any writable dir
MESHCORED_DATA_DIR=/data
# Raw packet rows older than this are pruned (hourly aggregates kept forever)
MESHCORED_PACKET_RETENTION_DAYS=90
# Store full packet payload hex alongside metadata (disk heavier, most useful)
MESHCORED_STORE_PACKET_PAYLOADS=true
# 0 = keep messages forever
MESHCORED_MESSAGE_RETENTION_DAYS=0
MESHCORED_RETENTION_INTERVAL_MINUTES=60

# --- Behaviour ---------------------------------------------------------------
# auto   = daemon fetches queued messages only while no proxy client is connected
# always = daemon always fetches (proxy clients will not receive queued messages)
# never  = daemon never fetches itself
MESHCORED_MESSAGE_FETCH_MODE=auto
# Seconds between contact-list delta syncs
MESHCORED_CONTACT_SYNC_INTERVAL=300

# --- Logging -------------------------------------------------------------------
MESHCORED_LOG_LEVEL=INFO
MESHCORED_LOG_FILE_MAX_BYTES=10485760
MESHCORED_LOG_FILE_BACKUPS=5

# --- gRPC API ------------------------------------------------------------------
MESHCORED_GRPC_HOST=0.0.0.0
MESHCORED_GRPC_PORT=50051

# --- MeshCore TCP proxy ----------------------------------------------------------
MESHCORED_PROXY_ENABLED=true
MESHCORED_PROXY_HOST=0.0.0.0
MESHCORED_PROXY_PORT=5000
# Seconds to cache read-only responses (contacts, device info, battery, ...)
MESHCORED_PROXY_CACHE_TTL=30
MESHCORED_PROXY_MAX_CLIENTS=8
